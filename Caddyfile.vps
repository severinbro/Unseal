{
	email {$ACME_EMAIL}

	# GDPR IP minimization (default logger): besides access logs, Caddy writes
	# per-request entries carrying client IP, User-Agent, Referer and the full URI
	# (incl. query string) to its default log. Drop those namespaces entirely:
	#   http.log.error               handler errors >= 500 (e.g. 502 while `api` restarts)
	#   http.handlers.reverse_proxy  "aborting with incomplete response" (client
	#                                disconnects mid-download), "reading from backend"
	#   http.stdlib                  recovered panics ("http: panic serving <ip:port>")
	# Startup, TLS/ACME and config messages are unaffected. Upstream failures stay
	# visible via `docker compose ps` and the `api` container log.
	log {
		exclude http.log.error http.handlers.reverse_proxy http.stdlib
	}
}

{$DOMAIN} {
	# GDPR IP minimization (access log): discard per-request client IP access logs
	log {
		output discard
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
	}

	# 1. JSON/GeoJSON REST API, multipart GeoJSON/.gpkg imports, and photo uploads
	handle /api/* {
		request_body {
			max_size 60MB
		}
		reverse_proxy api:3000
	}

	# 2. Hosted HTML pages for email confirmation (/auth/verify-email),
	#    password recovery (/auth/reset-password), and GDPR policy (/auth/privacy)
	handle /auth/* {
		reverse_proxy api:3000
	}

	# 3. EXIF-stripped WebP polygon site photos stored on `uploads_data` volume
	handle /uploads/* {
		reverse_proxy api:3000
	}

	# 4. Direct Android APK package download (/downloads/openunseal.apk)
	handle /downloads/* {
		reverse_proxy api:3000
	}

	# 5. Static Expo Web frontend (if exported to `./dist-web`)
	handle {
		header {
			Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https:; worker-src 'self' blob:; font-src 'self' data: https:; manifest-src 'self'; frame-ancestors 'none'"
		}
		root * /srv/www
		@manifest_json {
			path /manifest.json
			file /manifest.webmanifest
		}
		rewrite @manifest_json /manifest.webmanifest
		try_files {path} /index.html
		file_server
	}
}
