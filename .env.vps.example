# Unseal — Production VPS Configuration Template
# Copy to `.env.vps` on your VPS (`cp .env.vps.example .env.vps && chmod 600 .env.vps`)
# and start with:
#   docker compose --env-file .env.vps -f docker-compose.vps.yml up -d --build

# 1. Public Domain & Automatic Let's Encrypt TLS (DNS A/AAAA must point to this VPS)
DOMAIN=entsiegelung.example.org
ACME_EMAIL=admin@example.org

# 2. PostgreSQL 16 + PostGIS 3.4 Credentials (air-gapped on `db_internal` Docker network)
# Generate a strong random password, e.g.: openssl rand -hex 24
POSTGRES_USER=ppgis
POSTGRES_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_HEX_24
POSTGRES_DB=ppgis

# 3. Outbound Email Account (for Registration Confirmation & Password Recovery Links)
# Standard STARTTLS port 587 (`SMTP_SECURE=false`) or implicit TLS port 465 (`SMTP_SECURE=true`)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.org
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM="Unseal <noreply@example.org>"

# 4. German BKG VG250 Municipality Boundaries (auto-seeded on first boot if table is empty)
AUTO_SEED_VG250=true

# 5. CORS & Moderation Contact
CORS_ORIGIN=https://entsiegelung.example.org
ABUSE_CONTACT=moderation@example.org
DISCLAIMER_TEXT="Unverbindliche Bürgervorschläge zur Entsiegelung — unabhängig von Eigentumsverhältnissen."

# 6. Basemap & Optional Aerial Orthophoto Layer
OSM_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
ORTHOPHOTO_URL_TEMPLATE=
ORTHOPHOTO_TILE_SIZE=256
ORTHOPHOTO_ATTRIBUTION=
ORTHOPHOTO_BOUNDS=
ORTHOPHOTO_MAX_ZOOM=20

# 7. Default Map Camera & Quotas
INITIAL_LNG=9.9937
INITIAL_LAT=53.5511
INITIAL_ZOOM=15
MAX_DAILY_POLYGONS_PER_USER=25
SESSION_TTL_DAYS=30
