# Unseal - Production VPS Configuration Template
# Copy to `.env.vps` on your VPS (`cp .env.vps.example .env.vps && chmod 600 .env.vps`)
# and start with:
#   docker compose --env-file .env.vps -f docker-compose.vps.yml up -d --build

# 1. Public Domain & Automatic Let's Encrypt TLS (DNS A/AAAA must point to this VPS)
DOMAIN=entsiegelung.example.org
ACME_EMAIL=admin@example.org

# 2. PostgreSQL 16 + PostGIS 3.4 Credentials (air-gapped on `db_internal` Docker network)
# Generate a strong random password, e.g.: openssl rand -hex 24
POSTGRES_USER=ppgis
POSTGRES_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_HEX_24
POSTGRES_DB=ppgis

# 3. Outbound Email Account (for Registration Confirmation & Password Recovery Links)
# Standard STARTTLS port 587 (`SMTP_SECURE=false`) or implicit TLS port 465 (`SMTP_SECURE=true`)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
# Refuse to send if the server does not offer STARTTLS (protects links & addresses in transit)
SMTP_REQUIRE_TLS=true
SMTP_USER=noreply@example.org
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM="Unseal <noreply@example.org>"

# 4. German BKG VG250 Municipality Boundaries (auto-seeded on first boot if table is empty)
AUTO_SEED_VG250=true

# 5. CORS, Impressum (§ 5 DDG / § 18 MStV), DSGVO Controller & Moderation Contact
CORS_ORIGIN=https://entsiegelung.example.org
# Required for public German instances: operator name, summonable postal address (use \n for line breaks), and email
OPERATOR_NAME="Vorname Nachname / Organisation"
OPERATOR_ADDRESS="Musterstraße 1\n12345 Musterstadt\nDeutschland"
OPERATOR_EMAIL=kontakt@example.org
OPERATOR_PHONE=
ABUSE_CONTACT=moderation@example.org
BUG_REPORT_TO=kontakt@example.org
DISCLAIMER_TEXT="Unverbindliche Bürgervorschläge zur Entsiegelung - unabhängig von Eigentumsverhältnissen."
# Optional URL overrides (leave empty to use hosted /auth/impressum, /auth/privacy, /auth/terms, /auth/licenses)
IMPRESSUM_URL=
PRIVACY_POLICY_URL=
TERMS_URL=
LICENSES_URL=
SOURCE_CODE_URL=https://github.com/severinbro/Unseal
# Optional direct Android APK URL (leave empty to auto-enable /downloads/unseal.apk only when unseal.apk exists in uploads_data; "none" disables)
APK_DOWNLOAD_URL=
APK_SHA256=

# 6. Basemap & Aerial Orthophoto Layer (leave ORTHOPHOTO_URL_TEMPLATE empty for built-in Germany DOP20, or "none" to disable)
OSM_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
OSM_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/dark
ORTHOPHOTO_URL_TEMPLATE=
ORTHOPHOTO_TILE_SIZE=256
ORTHOPHOTO_ATTRIBUTION=
ORTHOPHOTO_BOUNDS=
ORTHOPHOTO_MAX_ZOOM=20

# 7. Default Map Camera & Quotas (defaults to Mainz Cathedral / Mainzer Dom)
INITIAL_LNG=8.2739
INITIAL_LAT=49.9989
INITIAL_ZOOM=15
MAX_DAILY_POLYGONS_PER_USER=25
SESSION_TTL_DAYS=30

# 8. Carbon Anti-Spam, Registration PoW & Moderation Thresholds
AUTH_CAPTCHA_ENABLED=true
# HMAC secret for registration proof-of-work: openssl rand -hex 32
# (empty or the placeholder = random secret per API process, which is also safe)
AUTH_CAPTCHA_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
DISPOSABLE_EMAIL_BLOCKLIST_EXTRA=
REQUIRE_JURISDICTION=when_seeded
STALE_UNRATED_PRUNE_DAYS=30
NEW_USER_MIN_ACCOUNT_DAYS=14
NEW_USER_MIN_CLEAN_POLYGONS=3

# GDPR pseudonymisation: HMAC key for tombstones of deleted pseudonyms and banned emails.
# Generate with `openssl rand -hex 32` and keep it stable: rotating it lifts existing email
# bans and pseudonym reservations. Required when NODE_ENV=production.
TOMBSTONE_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
# Days a self-deleted pseudonym stays reserved against impersonation before its tombstone is purged
PSEUDONYM_RESERVATION_DAYS=365

# Privacy policy details (shown on /auth/privacy): processors and backup retention.
# Example: PRIVACY_HOSTING_PROVIDER="Hetzner Online GmbH, Gunzenhausen (Deutschland)"
PRIVACY_HOSTING_PROVIDER=
PRIVACY_EMAIL_PROVIDER=
# Days backups are kept before they are deleted (see docs/vps-setup.md); leave empty if you keep none
BACKUP_RETENTION_DAYS=14

# 9. Optional Municipal Branding & White-Label Theme (leave empty for stock Unseal branding)
# Customizing these variables requires no code changes (preserving AGPL-3.0 / MPL-2.0 compliance).
APP_NAME=
APP_SUBTITLE_DE=
APP_SUBTITLE_EN=
# Prefer BRAND_LOGO_FILE (PNG/JPG/WebP/SVG <= 2 MiB inside uploads_data, e.g. /var/lib/entsiegelung/uploads/brand-logo.svg)
# served same-origin at /api/v1/branding/logo so no visitor IP is sent to an external image host.
BRAND_LOGO_FILE=
BRAND_LOGO_URL=
# 6-digit hex colors, e.g. #005A9C (dark accent auto-derives if BRAND_ACCENT_DARK_COLOR is left empty)
BRAND_ACCENT_COLOR=
BRAND_ACCENT_DARK_COLOR=
INTRO_ENABLED=true
MUNICIPAL_PORTAL_URL=
MUNICIPAL_PORTAL_LABEL=

# 10. Optional Outbound Webhooks (transmits exclusively public, non-PII polygon data to internal/external receivers)
# Allowed events: polygon.created,polygon.status_changed,polygon.deleted
WEBHOOK_URL=
# Optional HMAC-SHA256 secret (generate with `openssl rand -hex 32`); verified via X-Unseal-Signature-256
WEBHOOK_SECRET=
WEBHOOK_EVENTS=polygon.created,polygon.status_changed,polygon.deleted
WEBHOOK_TIMEOUT_MS=5000
# Keep false for public HTTPS targets (SSRF protection); set true only for trusted internal/Docker network receivers
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
