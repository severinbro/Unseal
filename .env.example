# OpenUnseal - Local Development Runtime & Docker Compose Configuration
# Copy to `.env` for local customization (`cp .env.example .env`).
# For production VPS deployment, see `.env.vps.example`, `docker-compose.vps.yml`, and `docs/vps-setup.md`.
#
# PostgreSQL / PostGIS Backup Command:
#   docker compose exec -T postgis pg_dump -U "${POSTGRES_USER:-ppgis}" -Fc "${POSTGRES_DB:-ppgis}" > backup-$(date +%Y%m%d).dump
# Restore Command:
#   docker compose exec -T postgis pg_restore -U "${POSTGRES_USER:-ppgis}" -d "${POSTGRES_DB:-ppgis}" --clean --if-exists < backup-YYYYMMDD.dump

# PostgreSQL 16 + PostGIS 3.4 credentials
POSTGRES_USER=ppgis
POSTGRES_PASSWORD=ppgis
POSTGRES_DB=ppgis

# Fastify API bind address, port, and database connection string
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://ppgis:ppgis@127.0.0.1:5432/ppgis

# Public base URL embedded in confirmation & password recovery email links
# (/auth/verify-email?token=..., /auth/reset-password?token=..., /auth/privacy)
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Local directory for EXIF-stripped WebP polygon photos (overridden to /var/lib/entsiegelung/uploads inside Docker)
UPLOADS_DIR=./uploads

# Automatically download & seed German BKG VG250 OpenData municipalities when empty
AUTO_SEED_VG250=true

# Outbound SMTP settings for registration confirmation & password recovery links
# In local `docker-compose.yml`, defaults to the bundled Mailpit web inbox at http://127.0.0.1:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
# Local Mailpit speaks plain SMTP; keep STARTTLS enforcement on (default) for real mail servers
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OpenUnseal <noreply@localhost>"

# Reverse proxy and CORS settings (set TRUST_PROXY=true behind Caddy/Nginx/Traefik)
TRUST_PROXY=false
CORS_ORIGIN=*

# Vector basemap style JSON URLs (OpenFreeMap Liberty light default & OpenFreeMap Dark default)
OSM_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
OSM_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# EPSG:3857 aerial orthophoto raster layer
# Leave ORTHOPHOTO_URL_TEMPLATE empty to use the built-in Germany-wide DOP20 orthophoto proxy,
# set to "none" to disable aerial imagery, or specify a custom XYZ / WMS template:
# XYZ template example: https://tiles.example.org/dop/{z}/{x}/{y}.jpg
# WMS template example: https://wms.example.org/service?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&LAYERS=dop20&STYLES=&FORMAT=image/jpeg&TRANSPARENT=false&CRS=EPSG:3857&WIDTH=256&HEIGHT=256&BBOX={bbox-epsg-3857}
ORTHOPHOTO_URL_TEMPLATE=
ORTHOPHOTO_TILE_SIZE=256
ORTHOPHOTO_ATTRIBUTION=
# Optional bounding box [minLng,minLat,maxLng,maxLat] in WGS 84 (defaults to Germany when built-in DOP20 is active)
ORTHOPHOTO_BOUNDS=
ORTHOPHOTO_MAX_ZOOM=20

# Initial map viewport camera (defaults to Mainz Cathedral / Mainzer Dom)
INITIAL_LNG=8.2739
INITIAL_LAT=49.9989
INITIAL_ZOOM=15

# Anti-abuse quotas & session lifetime
MAX_DAILY_POLYGONS_PER_USER=25
SESSION_TTL_DAYS=30

# Carbon anti-spam, registration PoW & moderation thresholds
AUTH_CAPTCHA_ENABLED=true
AUTH_CAPTCHA_SECRET=
DISPOSABLE_EMAIL_BLOCKLIST_EXTRA=
REQUIRE_JURISDICTION=when_seeded
# Optional Overpass API endpoint for public/private land-use lookups. Empty = disabled
# (local data only). Check the endpoint's terms first; /auth/privacy names the host.
OVERPASS_API_URL=
# Direct messages are deleted after this many days (stated on /auth/privacy).
CHAT_RETENTION_DAYS=365
STALE_UNRATED_PRUNE_DAYS=30
NEW_USER_MIN_ACCOUNT_DAYS=14
NEW_USER_MIN_CLEAN_POLYGONS=3

# GDPR pseudonymisation: HMAC key for tombstones of deleted pseudonyms and banned emails.
# Generate with `openssl rand -hex 32` and keep it stable: rotating it lifts existing email
# bans and pseudonym reservations. Required when NODE_ENV=production.
TOMBSTONE_SECRET=
# Days a self-deleted pseudonym stays reserved against impersonation before its tombstone is purged
PSEUDONYM_RESERVATION_DAYS=365

# Privacy policy details (shown on /auth/privacy): processors and backup retention.
# Example: PRIVACY_HOSTING_PROVIDER="Hetzner Online GmbH, Gunzenhausen (Deutschland)"
PRIVACY_HOSTING_PROVIDER=
PRIVACY_EMAIL_PROVIDER=
# Days backups are kept before they are deleted (see docs/vps-setup.md); leave empty if you keep none
BACKUP_RETENTION_DAYS=

# Public civic notice, Impressum (§ 5 DDG / § 18 MStV), DSGVO controller, & moderation contact
DISCLAIMER_TEXT="Community unsealing suggestions - non-binding public input, regardless of property ownership."
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
ABUSE_CONTACT=
BUG_REPORT_TO=
# Optional URL overrides (defaults to hosted /auth/impressum, /auth/privacy, /auth/terms, /auth/licenses)
IMPRESSUM_URL=
PRIVACY_POLICY_URL=
TERMS_URL=
LICENSES_URL=
SOURCE_CODE_URL=https://github.com/severinbro/Unseal

# Optional Android APK download link (auto-enabled at /downloads/openunseal.apk only when APK file exists; set to "none" to disable)
APK_DOWNLOAD_URL=
APK_SHA256=

# Optional Municipal Branding & White-Label Theme (leave empty for stock OpenUnseal branding)
# Customizing these variables requires no code changes and keeps upstream open-source licensing intact.
APP_NAME=
APP_SUBTITLE_DE=
APP_SUBTITLE_EN=
# Prefer BRAND_LOGO_FILE (PNG/JPG/WebP/SVG <= 2 MiB, served same-origin at /api/v1/branding/logo with zero third-party IP leak)
BRAND_LOGO_FILE=
BRAND_LOGO_URL=
# 6-digit hex colors, e.g. #005A9C (dark accent auto-derives if BRAND_ACCENT_DARK_COLOR is left empty)
BRAND_ACCENT_COLOR=
BRAND_ACCENT_DARK_COLOR=
INTRO_ENABLED=true
MUNICIPAL_PORTAL_URL=
MUNICIPAL_PORTAL_LABEL=

# Optional Outbound Webhooks (transmits exclusively public, non-PII polygon data to municipal GIS/ticketing/CMS systems)
# Events: polygon.created,polygon.status_changed,polygon.deleted
WEBHOOK_URL=
# Optional HMAC-SHA256 signing secret (sent in X-OpenUnseal-Signature-256); generate with: openssl rand -hex 32
WEBHOOK_SECRET=
WEBHOOK_EVENTS=polygon.created,polygon.status_changed,polygon.deleted
WEBHOOK_TIMEOUT_MS=5000
# Set true only when delivering to an internal/private network receiver (e.g., municipal intranet or Docker sidecar)
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Expo mobile / web local development API endpoint
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
