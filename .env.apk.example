# Unseal - Android Release APK Build & Signing Environment Template
# Copy to `.env.apk` (`cp .env.apk.example .env.apk && chmod 600 .env.apk`),
# fill in your production API URL and release keystore credentials, then load and build:
#   source .env.apk && (cd apps/mobile/android && ./gradlew assembleRelease --no-daemon)

# Public HTTPS base URL baked into the React Native / Expo JS bundle at build time
export EXPO_PUBLIC_API_BASE_URL="https://entsiegelung.example.org"

# Android release keystore path, alias, and passwords (read by apps/mobile/android/app/build.gradle)
export UNSEAL_UPLOAD_STORE_FILE="/path/to/unseal-release.keystore"
export UNSEAL_UPLOAD_STORE_PASSWORD="CHANGE_ME_STORE_PASSWORD"
export UNSEAL_UPLOAD_KEY_ALIAS="unseal-upload"
export UNSEAL_UPLOAD_KEY_PASSWORD="CHANGE_ME_KEY_PASSWORD"

# JDK 17 & Android SDK toolchain paths
export JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
export ANDROID_HOME="$HOME/Android/Sdk"
export PATH="$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$PATH"
