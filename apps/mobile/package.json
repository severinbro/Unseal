{
  "name": "@entsiegelung/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "main": "index.ts",
  "exports": {
    "./client": "./src/api/client.ts",
    "./appState": "./src/state/appState.ts",
    "./viewModels": "./src/state/viewModels.ts",
    "./tokenStorage": "./src/storage/tokenStorage.ts"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir ../../dist-web && node -e \"import('node:fs').then(fs=>fs.copyFileSync('../../THIRD_PARTY_NOTICES.txt','../../dist-web/THIRD_PARTY_NOTICES.txt'))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test"
  },
  "dependencies": {
    "@entsiegelung/shared": "*",
    "@expo/metro-runtime": "~4.0.0",
    "@maplibre/maplibre-react-native": "^10.0.0",
    "expo": "~52.0.0",
    "expo-document-picker": "~13.0.3",
    "expo-image-picker": "~16.0.6",
    "expo-location": "~18.0.4",
    "expo-secure-store": "~14.0.0",
    "maplibre-gl": "^4.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12"
  }
}
