{
  "name": "@openunseal/api",
  "version": "1.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./testHarness": {
      "types": "./dist/db/testHarness.d.ts",
      "default": "./dist/db/testHarness.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node -e \"import('node:child_process').then(({execSync})=>{if(process.env.SKIP_DOCKER_PRETEST!=='1')execSync('docker compose -f ../../docker-compose.yml up -d --wait postgis',{stdio:'inherit'})})\"",
    "test": "node --import tsx --test --test-concurrency=1",
    "migrate": "node dist/db/migrate.js",
    "admin": "node dist/cli/admin.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@openunseal/shared": "*",
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.1.1",
    "@node-rs/argon2": "^2.0.2",
    "exifr": "^7.1.3",
    "fastify": "^5.1.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10"
  }
}
